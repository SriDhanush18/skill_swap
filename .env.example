# ========================================================
# SkillSwap Platform - Environment Variables Configuration
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=skillswap-vignan-jwt-secret-key-2026
JWT_EXPIRES_IN=24h

# Google Gemini GenAI (for 20-Q Dynamic Assessment Generator & Certificate OCR)
GEMINI_API_KEY=

# Supabase PostgreSQL Cloud Sync (Optional - fallback to SQLite)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ========================================================
# Zoom Integration (Server-to-Server OAuth & Meeting SDK)
# ========================================================
# Obtain from Zoom App Marketplace -> Develop -> Build App:
# 1. Server-to-Server OAuth App (for automated meeting creation)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 2. Meeting SDK App (for embedded browser video calling signatures)
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# Note: If Zoom variables are left blank, SkillSwap automatically runs
# with the zero-latency real-time WebRTC + WebSocket P2P live mesh engine!
